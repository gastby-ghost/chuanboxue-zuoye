# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# Office / WPS 临时文件
~$*.doc
~$*.docx
~$*.ppt
~$*.pptx
~$*.xls
~$*.xlsx
.~lock.*
.~*

# 编辑器
.vscode/
.idea/
*.swp

# 本机工具配置
reasonix.toml

# 环境变量与密钥（公开仓库，务必不要提交）
.env
.env.*
!.env.example

# 临时文件
*.tmp
*.log

# Python 缓存
__pycache__/
*.pyc

# Word 导出：源为 .md，可用 tools/ 下的脚本随时重新生成，不入库
*.doc
*.docx

# 研究数据与分析产物（含模拟数据，均可由脚本重新生成）
data/
outputs/

# chat-relay 模式本地状态：开关文件（仅仓库根）与在途会话；技能本体在 .reasonix/，不受影响
/chat-relay/
topics/**/chat-relay/
